<%
  // Ширина полосы задаётся классом, а не style: CSP запрещает встроенные стили.
  // Шаги по 10%, ближайший снизу: для админки хватает точности.
  const safe = Math.min(100, Math.max(0, Math.round(Number(percent) || 0)));
  const step = Math.floor(safe / 10);
%>
<span class="funnel">
  <span class="funnel__value"><%= safe %>%</span>
  <span class="funnel__track"><span class="funnel__bar funnel__bar--<%= step %>"></span></span>
</span>
