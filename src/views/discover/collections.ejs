<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="micro-label">02 / Подборки</p>
      <hr class="rule">
      <a class="micro-label" href="/avtory">авторы →</a>
    </div>

    <h1 class="page-title">Подборки</h1>
    <p class="lede">Не «топ-100», а ответы на конкретные вопросы: что взять, если давно не читал, что почитать на ночь, что обсудить в клубе. В каждой — от семи до десяти книг с объяснением, зачем они здесь.</p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <% if (!collections.length) { %>
      <div class="empty-state">
        <h2 class="empty-state__title">Подборок пока нет</h2>
        <p class="empty-state__text">Они появятся, когда каталог наполнится. Можно начать с каталога — там уже есть книги.</p>
        <div class="empty-state__actions"><a class="btn btn--primary" href="/knigi">В каталог</a></div>
      </div>
    <% } else { %>
      <ul class="collection-grid list-clean">
        <% collections.forEach((collection, index) => { %>
          <li>
            <a class="collection-card" href="/podborki/<%= collection.slug %>">
              <p class="micro-label">№ <%= String(index + 1).padStart(2, '0') %></p>
              <h2 class="collection-card__title"><%= collection.title %></h2>
              <p class="collection-card__text"><%= collection.description %></p>
              <p class="micro-label"><%= collection.booksCount %> <%= t.plural(collection.booksCount, ['книга', 'книги', 'книг']) %> →</p>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>
