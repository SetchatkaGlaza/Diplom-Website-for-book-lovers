<section class="auth">
  <div class="container auth__inner">
    <div class="auth__intro">
      <p class="micro-label">Новый пароль</p>
      <h1 class="auth__title">Придумайте пароль</h1>
      <p class="auth__lead">После смены пароля все остальные устройства выйдут из аккаунта.</p>
    </div>

    <form class="auth__form card" method="post" action="/smenit-parol" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <%- include('../partials/field', {
        name: 'password',
        label: 'Новый пароль',
        type: 'password',
        error: errors.password,
        autocomplete: 'new-password',
        hint: 'Минимум 8 символов, буква и цифра'
      }) %>

      <%- include('../partials/field', {
        name: 'password_confirm',
        label: 'Повторите пароль',
        type: 'password',
        autocomplete: 'new-password'
      }) %>

      <button class="btn btn--primary btn--block" type="submit">Сохранить пароль</button>
    </form>
  </div>
</section>
