{
  "name": "knigomany",
  "version": "2.0.0",
  "description": "Книгоманы — читательский дневник, статистика чтения и клубы для русскоязычных читателей",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "db:migrate": "node src/db/migrate-cli.js up",
    "db:rollback": "node src/db/migrate-cli.js down",
    "db:status": "node src/db/migrate-cli.js status",
    "db:seed": "node src/db/seed.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"src/db/seed.js\" --test-coverage-exclude=\"src/server.js\" \"tests/**/*.test.js\"",
    "monitor": "bash scripts/monitor.sh",
    "backup": "bash scripts/backup.sh",
    "restore:check": "bash scripts/restore-check.sh",
    "content:load": "node src/db/seed-cli.js",
    "content:check": "node src/db/seed-cli.js --check",
    "digest": "node src/db/digest-cli.js run",
    "digest:dry": "node src/db/digest-cli.js run --dry-run",
    "digest:stats": "node src/db/digest-cli.js stats",
    "doctor": "node scripts/doctor.js",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "supertest": "^7.1.1"
  }
}
