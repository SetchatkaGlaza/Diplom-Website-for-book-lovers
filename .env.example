# ---- Приложение ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Адрес сайта без слэша на конце. От него строятся письма, canonical и sitemap.
# Локально можно не задавать — подставится http://localhost:3000
PUBLIC_URL=
# Подпись cookie сессии. В продакшене обязателен, минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ---- База данных ----
# По умолчанию ничего настраивать не нужно: если Postgres не отвечает,
# сайт сам поднимется на встроенной базе (PGlite) в папке .data.
# Эти строки — только если нужен именно настоящий Postgres.

# Продакшен: одна строка подключения (Neon, Railway, Supabase...)
# DATABASE_URL=postgres://user:password@host:5432/knigomany
DB_SSL=true

# Принудительный выбор базы:
#   pglite   — всегда встроенная (не требует установки Postgres)
#   postgres — всегда настоящий Postgres, даже если он недоступен
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=.data
# DB_SEED=false
# DB_RESET=true
# DB_MIGRATE=true

# Локальный Postgres, если он есть
DB_NAME=knigomany
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_LOGGING=false

# ---- Почта ----
# Не задано ничего — письма печатаются в лог (удобно локально, не годится на проде)
MAIL_FROM="Книгоманы <noreply@knigomany.ru>"
RESEND_API_KEY=
# Альтернатива Resend: обычный SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- Первый администратор (только для чистой базы прода) ----
ADMIN_EMAIL=
# Оставь пустым — пароль сгенерируется и напечатается один раз
ADMIN_PASSWORD=

# ---- Рассылка (дайджест) ----
# Запускается не таймером, а командой: npm run digest
# Пробный прогон без отправки: npm run digest:dry
# Сколько писем за один прогон (Resend не любит всплесков)
DIGEST_BATCH=50

# ---- Прочее ----
LOG_LEVEL=info
# В тестах 4, в продакшене оставь пустым: по умолчанию 12
BCRYPT_ROUNDS=
